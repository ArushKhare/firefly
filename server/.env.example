# Keys never reach the browser.
# One OpenRouter key covers both the LLM and Deepgram Aura-2 voice (deepgram/aura-2 via OpenRouter).
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-5.5
# Fast model for writing evacuation alerts (benchmarked ~2-3 s)
ALERT_MODEL=google/gemini-3.5-flash-lite
# TTS route: openrouter (default) or deepgram (then set DEEPGRAM_API_KEY)
TTS_VIA=openrouter
DEEPGRAM_API_KEY=
TTS_VOICE=aura-2-thalia-en
TTS_VOICE_ES=aura-2-celeste-es
PORT=8787
# Optional: auto-dispatch alerts to a webhook. KIND = ntfy | slack | discord | json
# Every message is prefixed [SIMULATION ...]. Use a private test channel only.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=ntfy
